# ============================================================
# 《食游记》环境变量示例
# ------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env：  copy .env.example .env
#   2. 填入你的真实 API Key
#   3. 重启应用
#
# 安全说明：
#   - Key 只保存在 .env（服务端读取），绝不暴露到前端
#   - 不要把 .env 提交到 Git（.gitignore 已包含）
# ============================================================

# ---------- 必填 ----------
# 你的大模型 API Key（OpenAI / DeepSeek / Qwen / 智谱 / Moonshot 等）
AI_API_KEY=

# ---------- 按供应商修改 ----------
# Base URL（OpenAI 兼容协议，换供应商只需改这里 + 模型名）：
#
#   【外国人友好 · 免费 · 只需邮箱注册 · 无需身份证】
#   Groq（推荐，速度快）: https://api.groq.com/openai/v1
#     模型: qwen/qwen3.8-27b（免费账号实测可用，中文好）
#     注册: https://console.groq.com （Google/邮箱登录即可）
#   GitHub Models（有 GitHub 账号即可）: https://models.github.ai/inference   模型: gpt-4o-mini
#     申请: https://github.com/settings/tokens 新建 Token 当 Key 用
#   OpenRouter（一个 Key 用很多免费模型）: https://openrouter.ai/api/v1
#     模型: meta-llama/llama-3.3-70b-instruct:free   注册: https://openrouter.ai
#
#   【国内供应商 · 需要中国手机号/实名】
#   OpenAI   : https://api.openai.com/v1        模型: gpt-4o-mini
#   DeepSeek : https://api.deepseek.com/v1      模型: deepseek-chat
#   Qwen     : https://dashscope.aliyuncs.com/compatible-mode/v1   模型: qwen-plus
#   智谱 GLM : https://open.bigmodel.cn/api/paas/v4                模型: glm-4-flash
#   Moonshot : https://api.moonshot.cn/v1       模型: moonshot-v1-8k
AI_BASE_URL=https://api.groq.com/openai/v1

# 模型名（图片识别需要支持 vision 的模型，如 gpt-4o-mini / qwen-vl-plus / glm-4v；
# 注意 Groq 的 llama 文本模型不支持图片识别）
AI_MODEL=qwen/qwen3.8-27b

# ---------- 图片识别（可选，免费）----------
# 主模型不含 vision 时（如 Groq），可单独配一个免费 vision 渠道。
# 推荐 GitHub Models（github.com/settings/tokens 新建 Token，免费、无需身份证）：
# AI_VISION_API_KEY=你的GitHub_Token
# AI_VISION_BASE_URL=https://models.github.ai/inference
# AI_VISION_MODEL=gpt-4o-mini

# ---------- 可选：生成参数 ----------
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1500
AI_TIMEOUT=60
